{
  "name": "@filecon/elements-solid",
  "version": "0.2.0",
  "description": "Filecon file icons as Web Components (<filecon-icon>) – the solid style (filled colored page). Works with any framework or plain HTML.",
  "keywords": [
    "filecon",
    "file-icons",
    "icons",
    "svg",
    "file-type",
    "web-components",
    "custom-elements",
    "html",
    "lit",
    "htmx"
  ],
  "homepage": "https://filecon.dev",
  "bugs": {
    "url": "https://github.com/dutobo/filecon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dutobo/filecon.git",
    "directory": "packages/elements-solid"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "dutobo",
    "url": "https://github.com/dutobo"
  },
  "contributors": [
    {
      "name": "rafaelk-f",
      "url": "https://github.com/rafaelk-f"
    }
  ],
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./dist/define.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@filecon/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons": {
      "@filecon/source": "./src/icons.ts",
      "import": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      },
      "require": {
        "types": "./dist/icons.d.cts",
        "default": "./dist/icons.cjs"
      }
    },
    "./define": {
      "@filecon/source": "./src/define.ts",
      "import": {
        "types": "./dist/define.d.ts",
        "default": "./dist/define.js"
      },
      "require": {
        "types": "./dist/define.d.cts",
        "default": "./dist/define.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@filecon/js-solid": "workspace:^",
    "@filecon/shared": "workspace:^"
  },
  "devDependencies": {
    "@filecon/testkit": "workspace:*",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./icons": {
        "import": {
          "types": "./dist/icons.d.ts",
          "default": "./dist/icons.js"
        },
        "require": {
          "types": "./dist/icons.d.cts",
          "default": "./dist/icons.cjs"
        }
      },
      "./define": {
        "import": {
          "types": "./dist/define.d.ts",
          "default": "./dist/define.js"
        },
        "require": {
          "types": "./dist/define.d.cts",
          "default": "./dist/define.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
