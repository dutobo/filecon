{
  "name": "@filecon/angular",
  "version": "0.3.1",
  "description": "Filecon file icons for Angular – all nine styles (default, gray, solid, papered, papered-flat, papered-craft, scratch, chalk, iconic). Standalone component, SSR-safe.",
  "keywords": [
    "filecon",
    "file-icons",
    "icons",
    "svg",
    "file-type",
    "angular",
    "angular-component",
    "standalone"
  ],
  "homepage": "https://filecon.dev",
  "bugs": {
    "url": "https://github.com/dutobo/filecon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dutobo/filecon.git",
    "directory": "packages/angular"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "dutobo",
    "url": "https://github.com/dutobo"
  },
  "contributors": [
    {
      "name": "rafaelk-f",
      "url": "https://github.com/rafaelk-f"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/filecon-angular.d.ts",
      "default": "./dist/fesm2022/filecon-angular.mjs"
    },
    "./icons": {
      "types": "./dist/types/filecon-angular.d.ts",
      "default": "./dist/fesm2022/filecon-angular.mjs"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/fesm2022/filecon-angular.mjs",
  "typings": "./dist/types/filecon-angular.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node -e \"require('node:fs').rmSync('dist/package.json')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@filecon/js": "workspace:^",
    "@filecon/shared": "workspace:^",
    "tslib": "^2.9.1"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@filecon/testkit": "workspace:*",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "ng-packagr": "^22.2.6",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/types/filecon-angular.d.ts",
        "default": "./dist/fesm2022/filecon-angular.mjs"
      },
      "./icons": {
        "types": "./dist/types/filecon-angular.d.ts",
        "default": "./dist/fesm2022/filecon-angular.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
