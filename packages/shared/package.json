{
  "name": "@filecon/shared",
  "version": "0.1.0",
  "description": "Filecon core: 703 file icon SVGs in three styles, manifest, types and the file-type resolver.",
  "keywords": [
    "filecon",
    "file-icons",
    "icons",
    "svg",
    "file-type",
    "file-type",
    "magic-bytes",
    "resolver"
  ],
  "homepage": "https://filecon.dev",
  "bugs": {
    "url": "https://github.com/dutobo/filecon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dutobo/filecon.git",
    "directory": "packages/shared"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "dutobo",
    "url": "https://github.com/dutobo"
  },
  "contributors": [
    {
      "name": "rafaelk-f",
      "url": "https://github.com/rafaelk-f"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@filecon/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./manifest.json": "./dist/manifest.json",
    "./svg/*": "./dist/svg/*"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@filecon/testkit": "workspace:*",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json",
      "./manifest.json": "./dist/manifest.json",
      "./svg/*": "./dist/svg/*"
    }
  }
}
